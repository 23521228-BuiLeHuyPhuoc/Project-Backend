extends ../layouts/default.pug

block main
  if permission.includes('dashboard-view')
    h1.box-title Tổng quan

    .section-1
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-1.svg" alt="Quản trị viên")
        .inner-content
          .inner-title Quản trị viên
          .inner-number= total.toLocaleString('vi-VN')
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-2.svg" alt="Đơn hàng")
        .inner-content
          .inner-title Đơn hàng
          .inner-number= totalOrder.toLocaleString('vi-VN')
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-3.svg" alt="Doanh thu")
        .inner-content
          .inner-title Doanh thu đã thanh toán
          .inner-number #{totalSum.toLocaleString('vi-VN')}đ

    section.recommendation-monitor(aria-labelledby="recommendation-monitor-title")
      .recommendation-monitor-hero
        .recommendation-monitor-heading
          .recommendation-monitor-kicker
            i.fa-solid.fa-chart-line
            | Recommendation intelligence
          h2#recommendation-monitor-title Hiệu quả hệ thống đề xuất
          p Tương tác trong #{recommendationMonitoring.windowDays} ngày gần nhất · Chất lượng đánh giá toàn hệ thống
        .recommendation-model-status(
          class=recommendationMonitoring.model.ready ? 'is-ready' : 'is-waiting'
        )
          span.inner-dot
          if recommendationMonitoring.model.training
            | Đang huấn luyện
          else if recommendationMonitoring.model.ready
            | Model sẵn sàng
          else
            | Chờ dữ liệu model

      .recommendation-metric-grid
        article.recommendation-metric-card.is-blue
          .recommendation-metric-head
            span.inner-icon
              i.fa-solid.fa-arrow-pointer
            span.inner-label CTR phản hồi
          .recommendation-metric-value= recommendationMonitoring.labels.ctr
          .recommendation-metric-caption
            | #{recommendationMonitoring.engagement.clickCount.toLocaleString('vi-VN')} click trên #{recommendationMonitoring.engagement.responseCount.toLocaleString('vi-VN')} phản hồi
          .recommendation-metric-track
            span(style=`width:${Math.min(100,recommendationMonitoring.engagement.ctr)}%`)

        article.recommendation-metric-card.is-teal
          .recommendation-metric-head
            span.inner-icon
              i.fa-solid.fa-cart-shopping
            span.inner-label Conversion rate
          .recommendation-metric-value= recommendationMonitoring.labels.conversion
          .recommendation-metric-caption
            | #{recommendationMonitoring.conversion.attributedClicks.toLocaleString('vi-VN')} / #{recommendationMonitoring.conversion.eligibleClicks.toLocaleString('vi-VN')} click đăng nhập tạo mua hàng
          .recommendation-metric-track
            span(style=`width:${Math.min(100,recommendationMonitoring.conversion.rate)}%`)

        article.recommendation-metric-card.is-gold
          .recommendation-metric-head
            span.inner-icon
              i.fa-solid.fa-star
            span.inner-label Điểm đánh giá TB
          .recommendation-metric-value
            | #{recommendationMonitoring.labels.averageRating}
            small / 5
          .recommendation-metric-caption
            | #{recommendationMonitoring.quality.reviewCount.toLocaleString('vi-VN')} đánh giá đã xuất bản
          .recommendation-metric-track
            span(style=`width:${Math.min(100,recommendationMonitoring.quality.averageRating/5*100)}%`)

        article.recommendation-metric-card.is-coral
          .recommendation-metric-head
            span.inner-icon
              i.fa-solid.fa-layer-group
            span.inner-label Review coverage
          .recommendation-metric-value= recommendationMonitoring.labels.coverage
          .recommendation-metric-caption
            | #{recommendationMonitoring.quality.reviewedTourCount.toLocaleString('vi-VN')} / #{recommendationMonitoring.quality.totalTours.toLocaleString('vi-VN')} tour đã có review
          .recommendation-metric-track
            span(style=`width:${Math.min(100,recommendationMonitoring.quality.reviewCoverage)}%`)

      if recommendationMonitoring.engagement.dataQuality==='partial'
        .recommendation-data-note.is-warning
          i.fa-solid.fa-triangle-exclamation
          span Chưa ghi nhận lượt bỏ qua recommendation, vì vậy CTR hiện tại có thể cao hơn thực tế.
      else if recommendationMonitoring.engagement.dataQuality==='empty'
        .recommendation-data-note
          i.fa-solid.fa-circle-info
          span Chưa có phản hồi recommendation trong khoảng thời gian thống kê.

      .recommendation-health-grid
        .recommendation-model-health
          .recommendation-panel-head
            div
              span.inner-eyebrow Model health
              h3 Sai số và độ chính xác
            i.fa-solid.fa-wave-square
          .recommendation-model-metrics
            .inner-item
              span.inner-label RMSE
              strong= recommendationMonitoring.labels.rmse
              small Càng thấp càng tốt
            .inner-item
              span.inner-label MAE
              strong= recommendationMonitoring.labels.mae
              small Sai lệch trung bình
            .inner-item
              span.inner-label Precision@#{recommendationMonitoring.model.precisionK || 'K'}
              strong= recommendationMonitoring.labels.precision
              small Chất lượng top đề xuất

        .recommendation-training-card
          .recommendation-panel-head
            div
              span.inner-eyebrow Vòng đời model
              h3 Lần huấn luyện gần nhất
            i.fa-solid.fa-rotate
          .recommendation-training-time= recommendationMonitoring.labels.lastTraining
          .recommendation-training-meta
            span
              i.fa-solid.fa-bolt
              | #{recommendationMonitoring.labels.trainingReason}
            span
              i.fa-solid.fa-database
              | Cache hit #{recommendationMonitoring.labels.cacheHitRate}
          .recommendation-cache-detail
            | #{recommendationMonitoring.cache.size.toLocaleString('vi-VN')} / #{recommendationMonitoring.cache.maxEntries.toLocaleString('vi-VN')} cache entries đang dùng

    .section-2
      .inner-head
        h2.inner-title Biểu đồ doanh thu thực tế
        .inner-filter
          input(type="month" value=currentMonthValue inputDate aria-label="Chọn tháng thống kê")
      .inner-chart
        canvas#revenue-chart

    .section-3.dashboard-recent-orders
      .dashboard-section-head
        div
          h2.inner-title Đơn hàng mới
          p 5 đơn gần nhất từ hệ thống
        a(href=`/${pathAdmin}/order/list`)
          | Xem tất cả
          i.fa-solid.fa-arrow-right
      .table-1
        table
          thead
            tr
              th Mã
              th Thông tin khách
              th Danh sách tour
              th Thanh toán
              th Trạng thái
              th.inner-text-right Ngày đặt
          tbody
            if recentOrders.length
              each order in recentOrders
                tr
                  td
                    a.inner-code(href=`/${pathAdmin}/order/edit/${order._id}`)= order.orderCode || '-'
                  td
                    .inner-text= order.fullName || 'Chưa cập nhật'
                    .inner-text SĐT: #{order.phone || '-'}
                    if order.note
                      .inner-text.dashboard-note= order.note
                  td
                    each item in order.items.slice(0,2)
                      .inner-item
                        .inner-image
                          img(src=item.avatar alt=item.name)
                        .inner-content
                          .inner-name= item.name
                          .inner-quantity Người lớn: #{item.quantityAdult || 0} · Trẻ em: #{item.quantityChildren || 0} · Em bé: #{item.quantityBaby || 0}
                    if order.items.length>2
                      .dashboard-more-items +#{order.items.length-2} tour khác
                  td
                    .inner-text Tổng tiền: #{Number(order.subTotal || 0).toLocaleString('vi-VN')}đ
                    .inner-text Giảm: #{Number(order.discount || 0).toLocaleString('vi-VN')}đ
                    .inner-text Thanh toán: #{Number(order.total || 0).toLocaleString('vi-VN')}đ
                    .inner-text= order.paymentMethodLabel
                    .inner-text= order.paymentStatus==='paid' ? 'Đã thanh toán' : 'Chưa thanh toán'
                  td
                    if order.status==='confirmed' || order.status==='completed'
                      .badge.badge-green= order.statusLabel
                    else if order.status==='cancelled'
                      .badge.badge-red= order.statusLabel
                    else
                      .badge.badge-orange= order.statusLabel
                  td.inner-text-right
                    .inner-text= order.createdAtTime
                    .inner-text= order.createdAtDate
            else
              tr
                td.dashboard-empty(colspan="6") Chưa có đơn hàng nào trong hệ thống.
