extends ../layouts/default.pug


block main
  h1.box-title Đơn hàng:#{orderRecord.orderCode}

  .section-8
    form#order-edit-form
      .inner-group
        input(type="hidden" id="id" value=orderRecord._id)
        label(class="inner-label" for="fullName") Tên khách hàng
        input(type="text" id="fullName" name="fullName" value=orderRecord.fullName)
      .inner-group
        label(class="inner-label" for="phone") Số điện thoại
        input(type="text" id="phone" name="phone" value=orderRecord.phone)
      .inner-group.inner-two-col
        label(class="inner-label" for="note") Ghi chú
        textarea(id="note" name="note") #{orderRecord.note}
      .inner-group
        label(class="inner-label" for="paymentMethod") Phương thức thanh toán
        select(id="paymentMethod" name="paymentMethod")
          option(value="") Ví Momo
          option(value="") VNPay
          option(value="") ZaloPay
      .inner-group
        label(class="inner-label" for="paymentStatus") Trạng thái thanh toán
        select(id="paymentStatus" name="paymentStatus")
          option(value="paid" selected=orderRecord.paymentStatus=="paid") Đã thanh toán
          option(value="unpaid" selected=orderRecord.paymentStatus=="unpaid") Chưa thanh toán
      .inner-group
        label(class="inner-label" for="createdAt") Ngày đặt
        input(type="datetime-local" id="createdAt" name="createdAt" value=orderRecord.FormatCreatedAt readonly)
      .inner-group
        label(class="inner-label" for="status") Trạng thái
        select(id="status" name="status")
          option(value="initial" selected=orderRecord.status=="initial") Khởi tạo
          option(value="completed" selected=orderRecord.status=="completed") Hoàn thành
          option(value="cancelled" selected=orderRecord.status=="cancelled") Hủy
      .inner-group
        label(class="inner-label") Danh sách tour
        .inner-order-list
          each item in orderRecord.items
            .inner-order-item
              .inner-order-image
                img(src=item.avatar, alt="")
              .inner-order-content
                .inner-order-name #{item.Name}
                .inner-order-text Người lớn: #{item.quantityAdult} x #{item.priceNewAdult.toLocaleString("vi-VN")}đ
                .inner-order-text Trẻ em: #{item.quantityChildren} x #{item.priceNewChildren.toLocaleString("vi-VN")}đ
                .inner-order-text Em bé: #{item.quantityBaby} x #{item.priceNewBaby.toLocaleString("vi-VN")}đ
                .inner-order-text Ngày khởi hành: #{item.FormatDepartureDate}
                .inner-order-text Khởi hành tại: #{item.locationNameFrom}
          
      .inner-group
        label(class="inner-label") Thanh toán
        .inner-order-total
          div Tổng tiền: #{(orderRecord.total + orderRecord.discount).toLocaleString("vi-VN")}đ
          div Giảm: #{orderRecord.discount.toLocaleString("vi-VN")}đ
          div Mã giảm: TOURMUAHE2024
          div Thanh toán: <span class="inner-order-price">#{orderRecord.total.toLocaleString("vi-VN")}đ</span>
      .inner-button.inner-two-col
        button Cập nhật
    .inner-back
      a(href=`/${pathAdmin}/order/list`) Quay lại danh sách