extends ../layouts/default.pug


block main
  h1.box-title Tạo tài khoản quản trị

  .section-8
    form#setting-account-admin-create-form
      .inner-group
        label(class="inner-label" for="fullName") Họ tên
        input(type="text" id="fullName" name="fullName")
      .inner-group
        label(class="inner-label" for="email") Email
        input(type="email" id="email" name="email")
      .inner-group
        label(class="inner-label" for="phone") Số điện thoại
        input(type="text" id="phone" name="phone")
      .inner-group
        label(class="inner-label" for="role") Nhóm quyền
        select(id="role" name="role")
          each role in roleList 
            option(value=role._id)=role.name
      .inner-group
        label(class="inner-label" for="positionCompany") Chức vụ
        input(type="text" id="positionCompany" name="positionCompany")
      .inner-group
        label(class="inner-label" for="status") Trạng thái
        select(id="status" name="status")
          option(value="initial") Khởi tạo
          option(value="active") Hoạt động
          option(value="inactive") Dừng hoạt động
      .inner-group
        label(class="inner-label" for="password") Mật khẩu
        .inner-password-control
          input(type="password" id="password" name="password" autocomplete="new-password")
          button.inner-password-toggle(type="button" data-password-toggle aria-label="Hiện mật khẩu")
            i.fa-solid.fa-eye
      .inner-group
        label(class="inner-label" for="confirmPassword") Xác nhận mật khẩu
        .inner-password-control
          input(type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password")
          button.inner-password-toggle(type="button" data-password-toggle aria-label="Hiện mật khẩu xác nhận")
            i.fa-solid.fa-eye
      .inner-group.inner-two-col
        label(class="inner-label" for="avatar") Ảnh đại diện
        div(class="inner-upload-image")
          input(type="file" id="avatar" accept="image/*" filepond-image name="avatar")
      .inner-button.inner-two-col
        button Tạo mới
    .inner-back
      a(href=`/${pathAdmin}/setting/account-admin/list`) Quay lại danh sách
