extends ../layouts/default.pug


block main
  h1.box-title Tạo nhóm quyền

  .section-8
    form#setting-role-create-form
      .inner-group
        label(class="inner-label" for="name") Tên nhóm quyền
        input(type="text" id="name" name="name")
      .inner-group
        label(class="inner-label" for="description") Mô tả ngắn
        input(type="text" id="description" name="description")
      .inner-group
        label(class="inner-label") Phân quyền
        .inner-permission-groups
          each group in permissionGroups
            .inner-permission-group
              strong=group.name
              .inner-checkbox-list
                each permission in group.permissions
                  .inner-checkbox-item
                    input(type="checkbox" name="permissions" value=permission.code id=`permission-${permission._id}`)
                    label(for=`permission-${permission._id}`)
                      span=permission.label
                      small #{permission.method} #{permission.path}
      .inner-button.inner-two-col
        button Tạo mới
    .inner-back
      a(href=`/${pathAdmin}/setting/role/list`) Quay lại danh sách
