        .container
            h2.box-title(
                data-aos-duration="800" 
                data-aos="fade-up"
                ) Khuyến Mại Bùng Nổ - Đánh Tan Nóng Bức
            .swiper.swiper-section-3(
                data-aos-delay="150" 
                data-aos-duration="800" 
                data-aos="fade-up"
                )
                .swiper-wrapper
                    .swiper-slide
                        .inner-item
                            a(href="#")
                                img(
                                    alt="" 
                                    src="/assets/images/banner-1.png"
                                    )
                    .swiper-slide
                        .inner-item
                            a(href="#")
                                img(
                                    alt="" 
                                    src="/assets/images/banner-2.png"
                                    )
                    .swiper-slide
                        .inner-item
                            a(href="#")
                                img(
                                    alt="" 
                                    src="/assets/images/banner-3.png"
                                    )
                    .swiper-slide
                        .inner-item
                            a(href="#")
                                img(
                                    alt="" 
                                    src="/assets/images/banner-3.png"
                                    )
                .swiper-pagination
    // End Section 3   
    // Section 4
    // Section 4
    

    .section-4
        .container
            h2.box-title(
                data-aos-duration="800" 
                data-aos="fade-up"
                ) Tour Trong Nước
            .inner-wrap(
                data-aos-delay="150" 
                data-aos-duration="800" 
                data-aos="fade-up"
                )
                each item in tourListSection4
                  +product-item(item)
            .inner-button
                a.button-outline(href=section4CategoryUrl) Xem tất cả
    // End Section 4
    // Section 5
    .section-5(
        data-aos-duration="800" 
        data-aos="fade-up"
        )
        .container
            .inner-image
                a(href="#")
                    img(
                        alt="" 
                        src="assets/images/banner-4.png"
                        )
    // End Section 5
    // Section 6    
    .section-4
        .container
            h2.box-title(
                data-aos-duration="800" 
                data-aos="fade-up"
                ) Tour Nước Ngoài
            .inner-wrap(
                data-aos-delay="150" 
                data-aos-duration="800" 
                data-aos="fade-up"
                )
                each item in tourListSection6
                  +product-item(item)
            .inner-button
                a.button-outline(href=section6CategoryUrl) Xem tất cả
    // End Section 6
    // Section 7
    .section-5(
        data-aos-duration="800" 
        data-aos="fade-up"
        )
        .container
            .inner-image
                a(href="#")
                    img(
                        alt="" 
                        src="assets/images/banner-5.png"
                        )
    // End Section 7
    // Section 8
    .section-8
        .container
            h2.box-title(
                data-aos-duration="800" 
                data-aos="fade-up"
                ) Tin Tức Mới
            .inner-wrap(
                data-aos-delay="150" 
                data-aos-duration="800" 
                data-aos="fade-up"
                )
                each article in newsList
                    if article.featured
                        .blog-item-2
                            a(href=`/tin-tuc/${article.slug}`)
                                .inner-image
                                    img(
                                        alt=article.title
                                        src=article.image
                                        )
                                .inner-content
                                    .inner-date #{article.date}
                                    h3.inner-title #{article.title}
                                    .inner-desc #{article.description}
                    else
                        .blog-item
                            a(href=`/tin-tuc/${article.slug}`)
                                .inner-image
                                    img(
                                        alt=article.title
                                        src=article.image
                                        )
                                .inner-content
                                    .inner-date #{article.date}
                                    h3.inner-title #{article.title}
            .inner-button(
                data-aos-duration="700"
                data-aos="fade-up"
                )
                a.button-outline(href="/tin-tuc") Xem tất cả tin tức
    // End Section 8
