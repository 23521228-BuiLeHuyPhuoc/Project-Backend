                    name: "Combo Đà Nẵng 2024: ĐÀ NẴNG - HỘI AN - BÀ NÀ HILL 2",
                    priceOld: 13650000,
                    priceNew: 2590000,
                    code: "TOUR000004",
                    departureDate: "22/12/2025",
                    time: "10 Ngày 9 Đêm",
