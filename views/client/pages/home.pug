extends ../layouts/default.pug
include ../mixins/product-item.pug
include ../partials/recommendation-section.pug
block main 
    .section-1
        .container
            .inner-wrap
                h1.inner-title(
                    data-aos-duration="800" 
                    data-aos="fade-up"
                    )
                    | Du lịch Châu Á - Khám phá Mỹ, Úc, Âu
                    br
                    | Đi nơi đâu bạn muốn
                p.inner-desc(
                    data-aos-delay="150" 
                    data-aos-duration="800" 
                    data-aos="fade-up"
                    )
                    | Từ nét đẹp văn hóa đặc sắc của châu Á đến những thành phố sôi động ở Mỹ, thiên nhiên kỳ vĩ của Úc và vẻ cổ kính, lãng mạn của châu Âu—thế giới đang chờ bạn khám phá.
                form.inner-form(
                    data-aos-delay="300" 
                    data-aos-duration="800" 
                    data-aos="fade-up" 
                    action="#"
                    form-search
                    )
                    .inner-box.inner-address
                        .inner-input-group
                            img.inner-icon(src="/assets/images/icon-address.svg")
                            input.inner-input(
                                placeholder="Bạn muốn đi đâu?" 
                                type="text"
                                name="locationTo"
                                )
                            i.fa-solid.fa-angle-down.inner-down
                        .inner-suggest
                            .inner-suggest-title
                                i.fa-solid.fa-location-dot
                                | Địa Điểm Hot
                            .inner-suggest-list
                                each item in hotDestinations
                                    .inner-item(data-search-value=item.searchValue)
                                        .inner-item-image
                                            img(
                                                alt=item.name
                                                src=item.avatar
                                                )
                                        .inner-item-content
                                            .inner-item-title= item.name
                                            .inner-item-desc #{item.ratingAvg.toFixed(1)} sao · #{item.ratingCount} đánh giá
                    .inner-box.inner-user
                        .inner-input-group
                            img.inner-icon(src="/assets/images/icon-user.svg")
                            input.inner-input(
                                placeholder="Số lượng" 
                                type="text"

                                )
                            i.fa-solid.fa-angle-down.inner-down
                        .inner-quantity
                            .inner-item
                                .inner-label Người lớn
                                .inner-count
                                    span.inner-down -
                                    span.inner-number(stock-adult) 1
                                    span.inner-up +
                            .inner-item
                                .inner-label Trẻ em
                                .inner-count
                                    span.inner-down -
                                    span.inner-number(stock-children) 0
                                    span.inner-up +
                            .inner-item
                                .inner-label Em bé
                                .inner-count
                                    span.inner-down -
                                    span.inner-number(stock-baby) 0
                                    span.inner-up +
                    .inner-box.inner-calendar
                        .inner-input-group
                            img.inner-icon(src="/assets/images/icon-calendar.svg")
                            input.inner-input(type="date" name="departureDate")
                    button.inner-button(type="submit")
                        i.fa-solid.fa-magnifying-glass
                        | Tìm Kiếm
            // End Section 1
        -
            var productListSection2 = [
                {
                    avatar: "/assets/images/product-1.jpg",
                    slug: "#",
                    discount: 30,
                    name: "Hà Nội - Lào Cai - SaPa 4N3Đ",
                    priceOld: 13650000,
                    priceNew: 2590000,
                    code: "TOUR000001",
                    departureDate: "22/12/2025",
                    time: "10 Ngày 9 Đêm",
                    ratingStars: 4,
                    ratingTotal: 20,
                    stock: 10
                },
                {
                    avatar: "/assets/images/product-2.jpg",
                    slug: "#",
                    discount: 0,
                    name: "Tour 2024 Phú Quốc - Thiên Đường Đảo Ngọc (3N2D)",
                    priceOld: 12000000,
                    priceNew: 12000000,
                    code: "TOUR000002",
                    departureDate: "24/12/2025",
                    time: "3 Ngày 2 Đêm",
                    ratingStars: 5,
                    ratingTotal: 30,
                    stock: 15
                },
                {
                    avatar: "/assets/images/product-3.jpg",
                    slug: "#",
                    discount: 30,
                    name: "Combo Đà Nẵng 2024: ĐÀ NẴNG - HỘI AN - BÀ NÀ HILL",
                    priceOld: 13650000,
                    priceNew: 2590000,
                    code: "TOUR000003",
                    departureDate: "22/12/2025",
                    time: "10 Ngày 9 Đêm",
                    ratingStars: 0,
                    ratingTotal: 0,
                    stock: 20
                },
                {
                    avatar: "/assets/images/product-3.jpg",
                    slug: "#",
