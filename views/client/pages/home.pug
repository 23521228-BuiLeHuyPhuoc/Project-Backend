                }
            ];



    // Section 2
    .section-2(
        data-aos-delay="450" 
        data-aos-duration="800" 
        data-aos="fade-up"
        )
        .container
            .inner-wrap
                .inner-info
                    h2.inner-title
                        | ƯU ĐÃI 2025
                        br
                        | TOUR GIỜ CHÓT
                    .inner-desc Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor
                    .inner-clock-title Kết thúc sau
                    .inner-clock-number(clock-expire="2028-12-10T15:00:00")
                        span.inner-item
                            .inner-number 00
                            .inner-label Ngày
                        span.inner-item
                            .inner-number 00
                            .inner-label Giờ
                        span.inner-item
                            .inner-number 00
                            .inner-label Phút
                        span.inner-item
                            .inner-number 00
                            .inner-label Giây
                    .inner-discount-title GIẢM ĐẾN
                    .inner-discount-price
                        | 990.000
                        span.inner-unit đ
                .inner-list
                    .swiper.swiper-section-2
                        .swiper-wrapper
                          each item in tourListSection2
                            .swiper-slide
                              +product-item(item)
                                    // End Product Item                           
                                    // End Section 2 
    -
      const topRatedHome={
        id:'top-rated-home',
        variant:'is-top-rated',
        endpoint:'/api/recommendation/top-rated?limit=8',
        source:'home',
        eyebrow:'Được cộng đồng kiểm chứng',
        title:'Tour được đánh giá cao',
        description:'Những hành trình nổi bật dựa trên điểm số và số lượng đánh giá thực tế.',
        icon:'fa-solid fa-star',
        contextualRerank:false
      }
    +recommendation-section(topRatedHome)
    if user
      -
        const personalizedHome={
          id:'personalized-home',
          variant:'is-personalized',
          endpoint:'/api/recommendation/personalized?limit=8',
          source:'home',
          eyebrow:'Được chọn theo sở thích của bạn',
          title:'Dành riêng cho bạn',
          description:'Gợi ý kết hợp sở thích, lịch sử tương tác và xu hướng đang được yêu thích.',
          icon:'fa-solid fa-sparkles'
        }
      +recommendation-section(personalizedHome)
                                    // Section 3
