extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug

block main
    +box-breadcrumb(breadcrumb)

    main.news-page
        .container
            .news-intro(
                data-aos-duration="700"
                data-aos="fade-up"
                )
                .inner-heading
                    span.inner-eyebrow Cẩm nang xê dịch
                    h2 Chuyện đường xa, cảm hứng thật gần
                p.inner-desc Khám phá điểm đến, văn hóa, ẩm thực và những kinh nghiệm hữu ích để mỗi hành trình của bạn đều đáng nhớ.

            - const featuredArticle = newsList.find(article => article.featured)
            if featuredArticle
                article.news-featured(
                    id=featuredArticle.slug
                    data-aos-delay="100"
                    data-aos-duration="700"
                    data-aos="fade-up"
                    )
                    .inner-image
                        img(
                            alt=featuredArticle.title
                            src=featuredArticle.image
                            )
                    .inner-content
                        .inner-label Bài viết nổi bật
                        .inner-meta
                            span
                                i.fa-regular.fa-calendar
                                | #{featuredArticle.date}
                            span
                                i.fa-regular.fa-clock
                                | #{featuredArticle.readTime}
                        h2.inner-title #{featuredArticle.title}
                        p.inner-desc #{featuredArticle.description}
                        .inner-category
                            i.fa-solid.fa-location-dot
                            | #{featuredArticle.category}

            .news-section-head(
                data-aos-duration="700"
                data-aos="fade-up"
                )
                div
                    span.inner-kicker Khám phá thêm
                    h2 Bài viết mới nhất
                .inner-line

            .news-grid
                each article, index in newsList
                    unless article.featured
                        article.news-card(
                            id=article.slug
                            data-aos-delay=(index % 3) * 80
                            data-aos-duration="650"
                            data-aos="fade-up"
                            )
                            .inner-image
                                img(
                                    alt=article.title
                                    loading="lazy"
                                    src=article.image
                                    )
                                span.inner-category #{article.category}
                            .inner-content
                                .inner-meta
                                    span #{article.date}
                                    span
                                        i.fa-regular.fa-clock
                                        | #{article.readTime}
                                h3.inner-title #{article.title}
                                p.inner-desc #{article.description}
