extends ../layouts/default.pug 
include ../mixins/box-breadcrumb.pug
include ../mixins/product-item.pug
block main 
    
    +box-breadcrumb(breadcrumb)
        // Section 9
    .section-9
        .container
            .inner-wrap
                .inner-left
                    // Box Filter
                    .box-filter
                        .inner-head
                            .inner-title Bộ Lọc
                            i.fa-solid.fa-filter
                        .inner-body
                            .inner-group
                                .inner-label Điểm đi
                                select(name="locationFrom")
                                    option(value="") -- Chọn điểm đi --
                                    each city in cityList
                                        option(value=city._id) #{city.name}
                            .inner-group
                                .inner-label Điểm đến
                                select(name="locationTo")
                                    option(value="") -- Chọn điểm đến --
                                    each city in cityList
                                        option(value=city.name) #{city.name}
                            .inner-group
                                .inner-label Ngày khởi hành
                                input(type="date" name="departureDate")
                            .inner-group
                                .inner-label Số Lượng Hành Khách
                                .inner-input-list
                                    .inner-input-item
                                        .inner-label Người lớn:
                                        input(
                                            value="0" 
                                            type="number"
                                            name="stockAdult"
                                            )
                                    .inner-input-item
                                        .inner-label Trẻ em:
                                        input(
                                            value="0" 
                                            type="number"
                                            name="stockChildren"
                                            )
                                    .inner-input-item
                                        .inner-label Em bé:
                                        input(
                                            value="0" 
                                            type="number"
                                            name="stockBaby"
                                            )
                            .inner-group
                                .inner-label Mức giá
                                select(name="priceRange")
                                    option(value="") -- Chọn khoảng giá --
                                    option(value="0-1000000") Dưới 1tr
                                    option(value="1000000-3000000") Từ 1tr đến 3tr
                                    option(value="3000000-6000000") Từ 3tr đến 6tr
                                    option(value="6000000-10000000") Từ 6tr đến 10tr
                                    option(value="10000000-99999999999999") Trên 10tr
                            .inner-group
                                button(class="inner-button" apply-filter-category-search) Áp Dụng
                    .inner-overlay
                    // End Box Filter
                .inner-right
                    .inner-info
                        h2.inner-title #{category.name}
                        .inner-desc
                            | !{category.description}
                    .inner-info-2
                        .inner-sort
                            .inner-label Sắp xếp:
                            .inner-list
                                each option in sortOptions
                                    a(
                                        class=option.active ? "active" : ""
                                        href=option.url
                                        aria-current=option.active ? "page" : null
                                    )
                                        | #{option.label}
                                        i(class=option.icon)
                        .inner-count-record
                            | Tất cả:
                            b  #{tourTotal} Tour
                        button.inner-filter-mobile
                            span.inner-title Bộ Lọc
                            i.fa-solid.fa-filter
                    .inner-list-tour 
                        if tourList.length
                            each item in tourList
                                +product-item(item)
                        else
                            p Không có tour phù hợp trong danh mục này.
                    // Pagination
                    if pagination.totalPages > 1
                        nav.box-pagination(aria-label="Phân trang danh sách tour")
                            if pagination.previousUrl
                                a(href=pagination.previousUrl aria-label="Trang trước")
                                    i.fa-solid.fa-angles-left
                            each pageItem in pagination.pages
                                a(
                                    class=pageItem.number === pagination.currentPage ? "active" : ""
                                    href=pageItem.url
                                    aria-current=pageItem.number === pagination.currentPage ? "page" : null
                                ) #{pageItem.number}
                            if pagination.nextUrl
                                a(href=pagination.nextUrl aria-label="Trang sau")
                                    i.fa-solid.fa-angles-right
                    // End Pagination
                    // End Section 9
