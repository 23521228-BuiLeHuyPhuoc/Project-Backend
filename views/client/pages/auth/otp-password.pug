extends ../../layouts/default.pug

block main
  section.auth-page.auth-recovery.auth-otp
    .container
      .auth-shell(data-aos="fade-up" data-aos-duration="650")
        .auth-visual
          .inner-visual-content
            .inner-kicker
              i.fa-solid.fa-shield-halved
              | Xác minh danh tính
            h1 Một bước nữa để trở lại hành trình.
            p Mã OTP giúp chúng tôi chắc chắn rằng chính bạn đang yêu cầu thay đổi mật khẩu tài khoản.
            ul.inner-benefits
              li
                i.fa-solid.fa-circle-check
                span Kiểm tra cả hộp thư rác nếu chưa thấy email
              li
                i.fa-solid.fa-user-shield
                span Không chia sẻ mã OTP với bất kỳ ai

        .auth-panel
          .inner-heading
            span.inner-eyebrow Bước 2 / 3
            h2 Nhập mã xác thực
            p Mã OTP đã được gửi tới email của bạn.

          .inner-email-note
            i.fa-regular.fa-envelope
            span Email nhận mã
            strong= email

          form.auth-form#client-otp-password-form(novalidate)
            input(type="hidden" name="email" value=email)
            .inner-field
              label(for="otp-password-code") Mã OTP
              .inner-control
                i.fa-solid.fa-key
                input#otp-password-code(type="text" name="otp" placeholder="000000" inputmode="numeric" maxlength="6" autocomplete="one-time-code")

            .inner-message(auth-message hidden)
            button.inner-submit(type="submit")
              span Xác nhận mã OTP
              i.fa-solid.fa-arrow-right

          .inner-switch
            span Chưa nhận được mã?
            a(href="/auth/forgot-password") Gửi yêu cầu mới
