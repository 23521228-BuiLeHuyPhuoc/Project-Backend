extends ../../layouts/default.pug

block main
  section.auth-page.auth-recovery.auth-reset-password
    .container
      .auth-shell(data-aos="fade-up" data-aos-duration="650")
        .auth-visual
          .inner-visual-content
            .inner-kicker
              i.fa-solid.fa-lock
              | Hoàn tất khôi phục
            h1 Mật khẩu mới, hành trình tiếp nối.
            p Tạo mật khẩu mạnh và dễ nhớ với bạn để tiếp tục khám phá những điểm đến yêu thích.
            ul.inner-benefits
              li
                i.fa-solid.fa-check
                span Tối thiểu 8 ký tự
              li
                i.fa-solid.fa-check
                span Có chữ hoa, chữ thường và chữ số
              li
                i.fa-solid.fa-check
                span Có ít nhất một ký tự đặc biệt

        .auth-panel
          .inner-heading
            span.inner-eyebrow Bước 3 / 3
            h2 Đặt lại mật khẩu
            p Nhập mật khẩu mới để hoàn tất việc khôi phục tài khoản.

          form.auth-form#client-reset-password-form(novalidate)
            .inner-field
              label(for="reset-password-new") Mật khẩu mới
              .inner-control
                i.fa-solid.fa-lock
                input#reset-password-new(type="password" name="password" placeholder="Tối thiểu 8 ký tự" autocomplete="new-password")
                button.inner-password-toggle(type="button" password-toggle aria-label="Hiện mật khẩu")
                  i.fa-regular.fa-eye

            .inner-field
              label(for="reset-password-confirm") Nhập lại mật khẩu
              .inner-control
                i.fa-solid.fa-shield-halved
                input#reset-password-confirm(type="password" name="confirmPassword" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password")
                button.inner-password-toggle(type="button" password-toggle aria-label="Hiện mật khẩu")
                  i.fa-regular.fa-eye

            .inner-message(auth-message hidden)
            button.inner-submit(type="submit")
              span Cập nhật mật khẩu
              i.fa-solid.fa-check

          .inner-switch
            span Muốn bắt đầu lại?
            a(href="/auth/forgot-password") Gửi mã OTP mới
