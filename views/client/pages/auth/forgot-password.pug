extends ../../layouts/default.pug

block main
  section.auth-page.auth-recovery.auth-forgot-password
    .container
      .auth-shell(data-aos="fade-up" data-aos-duration="650")
        .auth-visual
          .inner-visual-content
            .inner-kicker
              i.fa-solid.fa-key
              | Khôi phục tài khoản
            h1 Trở lại hành trình chỉ trong vài phút.
            p Nhập email đã đăng ký. 28.TRAVEL sẽ gửi mã xác thực để bạn thiết lập một mật khẩu mới an toàn.
            ul.inner-benefits
              li
                i.fa-solid.fa-envelope
                span Nhận mã OTP gồm 6 chữ số qua email
              li
                i.fa-solid.fa-clock
                span Mã xác thực có hiệu lực trong 5 phút
              li
                i.fa-solid.fa-shield-halved
                span Thông tin tài khoản luôn được bảo vệ

        .auth-panel
          .inner-heading
            span.inner-eyebrow Bắt đầu khôi phục
            h2 Quên mật khẩu?
            p Nhập email liên kết với tài khoản để nhận mã OTP xác thực.

          form.auth-form#client-forgot-password-form(novalidate)
            .inner-field
              label(for="forgot-password-email") Email
              .inner-control
                i.fa-regular.fa-envelope
                input#forgot-password-email(type="email" name="email" placeholder="ban@example.com" autocomplete="email")

            .inner-message(auth-message hidden)
            button.inner-submit(type="submit")
              span Gửi mã OTP
              i.fa-solid.fa-paper-plane

          .inner-switch
            span Đã nhớ mật khẩu?
            a(href="/auth/login") Quay lại đăng nhập
