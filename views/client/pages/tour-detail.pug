extends ../layouts/default.pug 
include ../mixins/box-breadcrumb.pug
include ../partials/recommendation-section.pug
block main

    
    +box-breadcrumb(breadcrumb)
    // End Breadcrumb
    // Section 10
    .section-10(data-behavior-page="tour-detail" data-tour-id=tour._id)
        .container
            .inner-wrap
                .inner-left
                    .box-images
                        .inner-images-main
                            .swiper.swiper-box-images-main
                                .swiper-wrapper
                                    each item in tour.images
                                      .swiper-slide
                                          .inner-image
                                              img(
                                                  alt="" 
                                                  src=item
                                                  )
                                    
                        .inner-images-thumb
                            .swiper.swiper-box-images-thumb
                                .swiper-wrapper
                                    each item in tour.images
                                      .swiper-slide
                                          .inner-image
                                              img(
                                                  alt="" 
                                                  src=item
                                                  )
                                    
                    .box-tour-info
                        .inner-title Thông Tin Tour
                        - const informationIsHtml=tour.informationIsHtml || /<[a-z][\s\S]*>/i.test(tour.information || '')
                        if informationIsHtml
                            .inner-content !{tour.information}
                        else
                            .inner-content.inner-content-plain= tour.information

                        .inner-read-more
                            button.button-outline Xem tất cả
                    .box-tour-schedule
                        .inner-title-main Lịch Trình Tour
                        each item in tour.schedules
                          .inner-list
                              .inner-item
                                  .inner-title #{item.title}
                                  .inner-content
                                      if item.image
                                          img(src=item.image alt=item.title loading="lazy")
                                      .inner-schedule-copy !{item.description}

                    .tour-review-section(data-review-section)
                        .tour-review-head
                            div
                                span Cảm nhận thực tế
                                h2 Đánh giá từ khách hàng
                            .tour-review-score
                                strong= ratingAverage ? ratingAverage.toFixed(1) : '0.0'
                                .inner-stars
                                    - for(let star=1;star<=5;star++)
                                        i(class=star <= Math.round(ratingAverage) ? 'fa-solid fa-star' : 'fa-regular fa-star')
                                span #{reviews.length} đánh giá
                        if reviews.length
                            .tour-review-list
                                each review in reviews
                                    article.tour-review-item
                                        .tour-review-avatar
                                            if review.userId && review.userId.avatar
                                                img(src=review.userId.avatar alt=review.userId.fullName)
                                            else
                                                span= review.userId ? review.userId.fullName.charAt(0).toUpperCase() : 'K'
                                        .tour-review-content
                                            .tour-review-meta
                                                strong= review.userId ? review.userId.fullName : 'Khách hàng'
                                                span= review.createdAtLabel
                                            .inner-stars
                                                - for(let star=1;star<=5;star++)
                                                    i(class=star <= review.rating ? 'fa-solid fa-star' : 'fa-regular fa-star')
                                            p= review.comment
                        else
                            .tour-review-empty Chưa có đánh giá cho tour này.
                                     
                            
                .inner-right
                    .box-tour-detail
                        .tour-detail-heading
                            .inner-title-main Chuyến Đi Của Bạn
                            button.tour-favorite-button(type="button" class=isFavorite ? 'is-active' : '' data-favorite-toggle=tour._id aria-label="Lưu tour yêu thích")
                                i(class=isFavorite ? 'fa-solid fa-heart' : 'fa-regular fa-heart')
                        .inner-product
                            .inner-image
                                img(
                                    alt="" 
                                    src=tour.avatar
                                    )
                            .inner-info
                                .inner-title #{tour.name}
                                    .inner-stars
                                        - for(let star=1;star<=5;star++)
                                            i(class=star <= Math.round(ratingAverage) ? 'fa-solid fa-star' : 'fa-regular fa-star')
                                    .inner-number #{reviews.length} lượt đánh giá
                        .inner-meta
                            .inner-item
                                i.fa-solid.fa-ticket-simple
                                span Mã Tour:
                                span.inner-highlight 28T00001
                            .inner-item
                                i.fa-solid.fa-calendar-days
                                span Thời Gian:
                                span.inner-highlight #{tour.time}
                            .inner-item
                                i.fa-solid.fa-truck-plane
                                span Phương Tiện:
                                span.inner-highlight #{tour.vehicle}
                            .inner-item
                                i.fa-solid.fa-calendar-days
                                span Ngày Khởi Hành:
                                span.inner-highlight #{tour.departureFormatDate}
                        .inner-form
                            label.inner-label Khởi Hành Tại:
                            select(location-from)
                                each location of tour.locations
                                    each CITY of city
                                        if String(location) == String(CITY._id)
                                            option(value=CITY._id) #{CITY.name}
                        .inner-quantity
                            label.inner-label Số Lượng Hành Khách
                            .inner-list
                                .inner-item
                                    .inner-item-label Người lớn:
                                    .inner-item-input
                                        input(
                                            value="1" 
                                            min="0" 
                                            max=tour.stockAdult
                                            type="number"
                                            input-stock-adult
                                            price=tour.priceNewAdult
                                            )
                                    .inner-item-price
                                        span(stock-adult) 1
                                        span x
                                        span.inner-highlight #{tour.priceNewAdult.toLocaleString("vi-VN")} đ
                                .inner-item
                                    .inner-item-label Trẻ em:
                                    .inner-item-input
                                        input(
                                            value="0" 
                                            min="0" 
                                            max=tour.stockChildren
                                            type="number"
                                            input-stock-children
                                            price=tour.priceNewChildren
                                            )
                                    .inner-item-price
                                        span(stock-children) 0
                                        span x
                                        span.inner-highlight  #{tour.priceNewChildren.toLocaleString("vi-VN")}
                                .inner-item
                                    .inner-item-label Em bé:
                                    .inner-item-input
                                        input(
                                            value="0" 
                                            min="0" 
                                            max=tour.stockBaby
                                            type="number"
                                            input-stock-baby
                                            price=tour.priceNewBaby
                                            )
                                    .inner-item-price
                                        span(stock-baby) 0
                                        span x
                                        span.inner-highlight  #{tour.priceNewBaby.toLocaleString("vi-VN")}
                        .inner-total
                            .inner-total-label Tổng cộng:
                            .inner-total-price 
                              span(total-price) #{tour.priceNewAdult.toLocaleString("vi-VN")}
                              span đ
                        button.inner-button-add-cart(
                            type="button"
                            tour-id=tour._id
                            data-authenticated=user ? "true" : "false"
                        )= user ? "Thêm Vào Giỏ Hàng" : "Đăng Nhập Để Đặt Tour"
    // End Section 10
    -
      const similarTours={
        id:'similar-tours',
        variant:'is-similar',
        endpoint:`/api/recommendation/similar/${tour._id}?limit=4`,
        source:'detail',
        eyebrow:'Cùng phong cách hành trình',
        title:'Tour tương tự',
        description:'Khám phá thêm những chuyến đi có điểm đến, thời lượng và trải nghiệm gần với tour này.',
        icon:'fa-solid fa-route'
      }
    +recommendation-section(similarTours)
    if user
      -
        const personalizedDetail={
          id:'personalized-detail',
          variant:'is-personalized',
          endpoint:'/api/recommendation/personalized?limit=4',
          source:'detail',
          eyebrow:'Có thể hợp gu của bạn',
          title:'Bạn có thể thích',
          description:'Các lựa chọn được cân bằng từ sở thích cá nhân và hành vi gần đây của bạn.',
          icon:'fa-solid fa-heart'
        }
      +recommendation-section(personalizedDetail)
