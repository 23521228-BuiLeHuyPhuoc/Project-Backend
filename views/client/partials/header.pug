// Top Header
.top-header
  .container
    .inner-wrap
      .inner-item
        i.fa-solid.fa-phone
        | #{settingWebsiteInfo.phone}
      .inner-item
        i.fa-solid.fa-envelope
        | #{settingWebsiteInfo.email}
      .inner-item
        i.fa-solid.fa-building
        | #{settingWebsiteInfo.address}
// End Top Header
// Header
header.header
  .container
    .inner-wrap
      // Menu Mobile
      button.inner-menu-mobile
        i.fa-solid.fa-bars
      // Logo
      .inner-logo
        a(href="/")
          img(
            alt="28.TRAVEL" 
            src="/assets/images/logo.png"
            )
      // Menu
      nav.inner-menu
        ul
          li
            a(
              class=currentPath === "/" ? "active" : ""
              href="/"
              ) Trang chủ
          each item in categoryTree
            li
              a(href=`/category/${item.slug}`) #{item.name}
              i.fa-solid.fa-caret-down
              ul
                -if(item.children)
                each child in item.children
                  li
                    a(href=`/category/${child.slug}`) #{child.name}
          li
            a(
              class=currentPath && currentPath.startsWith("/tin-tuc") ? "active" : ""
              href="/tin-tuc"
              ) Tin tức
          li
            a(href="#") Liên hệ
        .inner-overlay
      // Client actions
      if user
        .inner-client-actions
          .inner-notification
            a(href="/account/notifications" aria-label="Thông báo" title="Thông báo" data-header-notification)
              i.fa-regular.fa-bell
              span(
                data-header-notification-badge
                hidden=!notificationUnreadCount
                aria-label="Số thông báo chưa đọc"
              )= notificationUnreadCount
          .inner-cart
            a(href="/cart" aria-label="Giỏ hàng")
              img(
                alt="Cart"
                src="/assets/images/icon-cart.svg"
                )
              span(mini-cart)= cartCount
      .inner-athentication
        if user
          .inner-user-menu
            button.inner-user-trigger(type="button" user-menu-trigger aria-label="Mở menu tài khoản" title=user.fullName)
              span.inner-avatar #{user.fullName.charAt(0).toUpperCase()}
            .inner-user-dropdown
              a(href="/account")
                i.fa-solid.fa-table-cells-large
                |  Tài khoản của tôi
              a(href="/account/orders")
                i.fa-solid.fa-suitcase-rolling
                |  Đơn hàng
              a(href="/account/notifications")
                i.fa-regular.fa-bell
                |  Thông báo
              a(href="/account/favorites")
                i.fa-regular.fa-heart
                |  Tour yêu thích
              form(action="/auth/logout" method="post")
                button(type="submit")
                  i.fa-solid.fa-arrow-right-from-bracket
                  |  Đăng xuất
        else
          a(href="/auth/login") Đăng nhập
          a(href="/auth/register") Đăng ký
// End Header
